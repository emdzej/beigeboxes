 use crate::bus::{Address, Bus, InspectRun, InspectableBus};
@@ -1386,6 +1387,31 @@ impl Emulator {
         let _ = self.status_update();
     }
 
+    /// For a frontend that runs the emulator in-process, without threads (wasm):
+    /// whether it is running, as the tick loop must not be entered while stopped
+    pub fn is_running(&self) -> bool {
+        self.run
+    }
+
+    /// For a frontend without threads: a floppy drive's (disk inserted, motor on),
+    /// or None if there is no such drive
+    pub fn fdd_state(&self, drive: usize) -> Option<(bool, bool)> {
+        let d = self.config.swim().drives.get(drive)?;
+        d.is_present().then_some((d.floppy_inserted, d.motor))
+    }
+
+    /// For a frontend without threads: the disk in a floppy drive as it is now
+    pub fn fdd_image(&self, drive: usize) -> Option<&snow_floppy::FloppyImage> {
+        let d = self.config.swim().drives.get(drive)?;
+        d.floppy_inserted.then_some(&d.floppy)
+    }
+
+    /// For a frontend without threads: sends the status events (ejected disks
+    /// among them) now, rather than at the next interval
+    pub fn poll_status(&mut self) -> Result<()> {
+        self.status_update()
+    }
+
     pub fn get_cycles(&self) -> Ticks {
         self.config.cpu_cycles()
     }
